# App
APP_NAME=Wildlife Population Intelligence System
ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (Docker Compose default; edit host/port for local Postgres)
DATABASE_URL=postgresql+psycopg2://wildlife:wildlife@db:5432/wildlife_db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Media storage (local dev; swap for S3/Azure Blob later)
MEDIA_STORAGE_PATH=./storage/media

# Dataset download targets (Milestone 1 dataset integration)
DATASETS_DIR=./storage/datasets
KAGGLE_USERNAME=
KAGGLE_KEY=
GBIF_API_BASE=https://api.gbif.org/v1
