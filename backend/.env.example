cat > backend/.env.example << 'ENVEOF'
# App
APP_NAME=Wildlife Population Intelligence System
VERSION=1.0.0
ENV=development
DEBUG=True
API_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+psycopg2://wildlife:wildlife@db:5432/wildlife_db

# CORS (JSON list format)
FRONTEND_ORIGIN=["http://localhost:5173","http://localhost:3000"]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ML
ENABLE_IMAGE_ANALYSIS=true
ENABLE_AUDIO_ANALYSIS=true
ENABLE_ML_MODELS=false

# Storage
MEDIA_STORAGE_PATH=./storage/media
DATASETS_DIR=./storage/datasets

# ML Paths
YOLO_MODEL_PATH=./models/yolov8_wildlife.pt
SPECIES_CLASSIFIER_PATH=./models/species_classifier.h5
AUDIO_MODEL_PATH=./models/birdnet_model.tflite
POPULATION_MODEL_PATH=./models/population_estimator.pkl

# External APIs
KAGGLE_USERNAME=
KAGGLE_KEY=
GBIF_API_BASE=https://api.gbif.org/v1
ENVEOF