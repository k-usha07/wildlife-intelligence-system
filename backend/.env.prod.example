cat > backend/.env.prod.example << 'ENVEOF'
# Production secrets — copy to backend/.env.prod and fill in real values.
# NEVER commit the filled-in .env.prod file.

# App
APP_NAME=Wildlife Population Intelligence System
VERSION=1.0.0
ENV=production
DEBUG=False
API_PREFIX=/api/v1

# Security
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=wildlife
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=wildlife_db
DATABASE_URL=postgresql+psycopg2://wildlife:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/wildlife_db

# CORS (JSON list format)
FRONTEND_ORIGIN=["https://wildlife-intelligence-system.vercel.app"]

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_REDIS_PASSWORD

# ML
ENABLE_IMAGE_ANALYSIS=true
ENABLE_AUDIO_ANALYSIS=true
ENABLE_ML_MODELS=true

# Storage
MEDIA_STORAGE_PATH=/app/storage/media
DATASETS_DIR=/app/storage/datasets

# ML Paths
YOLO_MODEL_PATH=/app/models/yolov8_wildlife.pt
SPECIES_CLASSIFIER_PATH=/app/models/species_classifier.h5
AUDIO_MODEL_PATH=/app/models/birdnet_model.tflite
POPULATION_MODEL_PATH=/app/models/population_estimator.pkl

# External APIs
KAGGLE_USERNAME=
KAGGLE_KEY=
GBIF_API_BASE=https://api.gbif.org/v1

# Workers
BACKEND_WORKERS=4
ENVEOF